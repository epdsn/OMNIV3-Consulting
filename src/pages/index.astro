    <div class="border-t border-white/10">
      <p class="mx-auto w-full max-w-6xl px-5 py-6 text-xs text-cream/35 md:px-8">
        © {new Date().getFullYear()} OMNIV3 Consulting. All rights reserved.
      </p>
    </div>
  </footer>

  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <script>
    const toggle = document.querySelector("#menu-toggle");
    const mobileNav = document.querySelector("#mobile-nav");
    const form = document.querySelector("#contact-form");
    const submitButton = document.querySelector("#contact-submit");
    const statusMessage = document.querySelector("#form-status");
    const packageSelect = document.querySelector("#package-select");

    const setPackage = (value: string) => {
      if (!(packageSelect instanceof HTMLSelectElement)) return;
      const allowed = ["core", "growth", "flagship", "unsure"];
      if (allowed.includes(value)) packageSelect.value = value;
    };

    document.querySelectorAll("[data-package]").forEach((el) => {
      el.addEventListener("click", () => {
        const value = el.getAttribute("data-package");
        if (value) setPackage(value);
      });
    });

    if (toggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
      toggle.addEventListener("click", () => {
        const open = !mobileNav.classList.contains("hidden");
        mobileNav.classList.toggle("hidden", open);
        toggle.setAttribute("aria-expanded", String(!open));
        toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
      });

      mobileNav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav.classList.add("hidden");
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Open menu");
        });
      });
    }

    if (form instanceof HTMLFormElement && submitButton instanceof HTMLButtonElement && statusMessage) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const payload = {
          name: String(formData.get("name") ?? "").trim(),
          email: String(formData.get("email") ?? "").trim(),
          company: String(formData.get("company") ?? "").trim(),
          package: String(formData.get("package") ?? "").trim(),
          projectDetails: String(formData.get("projectDetails") ?? "").trim(),
        };

        statusMessage.textContent = "Sending…";
        statusMessage.className = "text-sm leading-6 text-cream/70";
        submitButton.disabled = true;
        submitButton.textContent = "Sending…";

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.message ?? "Something went wrong.");
          statusMessage.textContent = data.message ?? "Thanks — we’ll follow up shortly.";
          statusMessage.className = "text-sm leading-6 text-accent";
          form.reset();
        } catch (error) {
          statusMessage.textContent =
            error instanceof Error ? error.message : "Unexpected error occurred.";
          statusMessage.className = "text-sm leading-6 text-red-400";
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = "Send message";
        }
      });
    }
  </script>
</Base>
